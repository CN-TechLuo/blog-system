# ============================================================
# 生产环境变量模板：复制为 .env 并填写真实值
#   cp .env.example .env
# 切勿将 .env 提交到 Git（已在 .gitignore 中）
# ============================================================

# 数据库（compose 默认业务/备份都用 root；最小权限账号为可选加固）
DB_PASSWORD=CHANGE_ME_ROOT_PASSWORD
# 可选：启用 ops/mysql-init 创建最小权限账号后，把 compose 里 DB_USERNAME/DB_USER 改为 blog_app/blog_backup
DB_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
DB_BACKUP_PASSWORD=CHANGE_ME_BACKUP_PASSWORD

# 备份加密密钥：openssl rand -base64 48 > ops/backup.key && chmod 600 ops/backup.key
# docker-compose.prod.yml 会挂载为 /run/secrets/backup_key

# JWT 密钥（生成: openssl rand -base64 32）
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM

# 大模型 API Key（AI 助手功能，兼容 OpenAI 协议的服务商均可：DeepSeek/月之暗面/通义/智谱）
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# 前端域名（CORS 与重置密码链接）
CORS_ORIGINS=https://blog.example.com
RESET_PASSWORD_URL=https://blog.example.com/reset-password

# 限流存储：生产多实例必须 redis
RATE_LIMIT_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379

# 图形验证码：生产必须开启；多实例部署存储用 redis
CAPTCHA_ENABLED=true
CAPTCHA_STORE=redis

# SMTP（找回密码邮件，生产必须配置真实 SMTP）
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=465
# SPRING_MAIL_USERNAME=no-reply@example.com
# SPRING_MAIL_PASSWORD=CHANGE_ME
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true

# 一次性管理员引导令牌（首次部署设置；引导完成后可清空）
# 调用: POST /api/bootstrap/admin  X-Bootstrap-Token: <token>  {"userId": 1}
ADMIN_BOOTSTRAP_TOKEN=CHANGE_ME_ONE_TIME_BOOTSTRAP_TOKEN
